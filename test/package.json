{
  "name": "@praetor/test",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --config vitest.unit.config.ts",
    "test:int": "vitest run --config vitest.int.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test:warp": "vitest run --config vitest.warp.config.ts",
    "test:redteam": "vitest run --config vitest.redteam.config.ts redteam/suite/scripted.test.ts",
    "test:redteam:live": "vitest run --config vitest.redteam.config.ts redteam/suite/live.test.ts",
    "test:redteam:global": "REDTEAM_GLOBAL=1 vitest run --config vitest.redteam.config.ts redteam/suite/global.test.ts"
  },
  "devDependencies": {
    "@praetor/bundler": "workspace:*",
    "@praetor/chain": "workspace:*",
    "@praetor/db": "workspace:*",
    "@praetor/fisco-client": "workspace:*",
    "@praetor/protocol": "workspace:*",
    "@praetor/soter-attester": "workspace:*",
    "@praetor/userop": "workspace:*",
    "@praetor/weid-client": "workspace:*",
    "@types/node": "22.20.5",
    "drizzle-orm": "0.44.7",
    "typescript": "5.9.3",
    "viem": "2.57.5",
    "vitest": "3.2.7",
    "yaml": "2.9.1",
    "zod": "3.25.76"
  }
}
