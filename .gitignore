# Secrets: .env holds every private key and human-provided secret (mode 600, never committed)
.env
.env.*
!.env.example
*.key
*.pem
!**/fixtures/**/*.pem
/keys/
/secrets/

# Runtime
.run/
node_modules/
dist/
coverage/

# Foundry
contracts/*/out/
contracts/*/cache/
contracts/*/broadcast/
contracts/fisco/sm/build/
packages/protocol/out/
packages/protocol/cache/
spikes/**/out/
spikes/**/cache/
spikes/**/broadcast/

# Java / Gradle
.gradle/
build/
*.class

# FISCO / WeIdentity generated material (certs and node keys)
infra/fisco/nodes/
infra/fisco/downloads/
# WeCross router and account manager configuration (TLS keys, passwords), generated by the wecross setup
infra/wecross/generated/
spikes/**/nodes/
spikes/**/downloads/

# Spike downloads and generated chains (large binaries, node keys, certificates)
spikes/V2-fisco/nodes-sm/
spikes/**/downloads/
spikes/V2-fisco/sm_cert.cnf
spikes/V3-weid/scenario/out/
infra/deployments/*-it.json

# The coding assistant's local instructions and settings stay on the build machine
CLAUDE.md
.claude/
apps/web/test-results/
apps/web/playwright-report/
