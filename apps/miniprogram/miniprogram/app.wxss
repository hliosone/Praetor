/* Praetor in WeChat: the tokens of the web app (apps/web/src/styles.css, spec 07; a test keeps them equal), flat (no
 * WebGL), dark only, depth from cards and shadows. Green executed, amber waiting for a human, red refused or frozen. */

page {
  --paper: #050506;
  --sheet: #101113;
  --ink: #f4f5f2;
  --graphite: #9aa1a9;
  --hairline: rgba(255, 255, 255, 0.1);
  --glass: rgba(255, 255, 255, 0.035);
  --well: rgba(255, 255, 255, 0.06);
  --signed: #34d399;
  --asked: #fbbf24;
  --refused: #f87171;
  --usdc: #8fb4ff;
  --gold: #d4af37;
  --silver: #c7ccd4;

  background: radial-gradient(900rpx 600rpx at 80% -10%, rgba(132, 146, 170, 0.2), transparent 62%), var(--paper);
  min-height: 100%;
  color: var(--ink);
  font-family: 'Inter', -apple-system, 'PingFang SC', 'Noto Sans SC', 'Microsoft YaHei', sans-serif;
  font-size: 15px;
  line-height: 1.55;
  font-variant-numeric: tabular-nums;
}

.stage { padding: 16px; padding-bottom: 40px; }
.card {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.02)), var(--sheet);
  border: 1px solid var(--hairline);
  border-radius: 14px;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 18px 48px rgba(0, 0, 0, 0.35);
  padding: 16px;
  margin-bottom: 12px;
}
.panel { border-radius: 24px; }
.row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.between { justify-content: space-between; }
.stack > view { margin-bottom: 8px; }

.h1 { font-size: 30px; font-weight: 750; letter-spacing: -0.02em; line-height: 1.2; }
.h2 { font-size: 19px; font-weight: 650; line-height: 1.3; margin-bottom: 8px; }
.big { font-size: 44px; font-weight: 750; letter-spacing: -0.02em; line-height: 1.1; }
.label { color: var(--graphite); font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 650; }
.muted { color: var(--graphite); }
.small { font-size: 13px; }
.mono { font-family: 'IBM Plex Mono', Menlo, monospace; font-size: 13px; word-break: break-all; }
.error { color: var(--refused); }
.notice { border-left: 3px solid var(--asked); padding: 6px 12px; background: rgba(251, 191, 36, 0.06); border-radius: 6px; }

.pill { display: inline-flex; align-items: center; padding: 2px 10px; border-radius: 999px; font-size: 13px; font-weight: 650; border: 1px solid; }
.pill.signed { color: var(--signed); border-color: rgba(52, 211, 153, 0.4); background: rgba(52, 211, 153, 0.08); }
.pill.asked { color: var(--asked); border-color: rgba(251, 191, 36, 0.4); background: rgba(251, 191, 36, 0.08); }
.pill.refused { color: var(--refused); border-color: rgba(248, 113, 113, 0.4); background: rgba(248, 113, 113, 0.08); }
.pill.muted { color: var(--graphite); border-color: var(--hairline); }
.dot { width: 9px; height: 9px; border-radius: 3px; display: inline-block; margin-right: 6px; }
.dot.USDC { background: var(--usdc); }
.dot.tXAU { background: var(--gold); }
.dot.tXAG { background: var(--silver); }

.banner { background: var(--refused); color: var(--paper); border-radius: 14px; padding: 14px 16px; margin-bottom: 12px; font-weight: 650; }
.banner .small { font-weight: 400; }

button { margin: 0; border-radius: 999px; font-size: 15px; font-weight: 650; line-height: 1.4; padding: 12px 18px; background: var(--well); color: var(--ink); border: 1px solid var(--hairline); }
button::after { border: none; }
button.primary { background: var(--ink); color: var(--paper); border-color: var(--ink); }
button.danger { background: rgba(248, 113, 113, 0.14); color: #ffd4d4; border-color: rgba(248, 113, 113, 0.45); }
button[disabled] { opacity: 0.5; }
.actions button { margin-top: 10px; width: 100%; }

.item { padding: 10px 0; border-bottom: 1px solid var(--hairline); }
.item:last-child { border-bottom: none; }
input, textarea { color: var(--ink); background: rgba(0, 0, 0, 0.35); border: 1px solid var(--hairline); border-radius: 10px; padding: 10px 12px; }
