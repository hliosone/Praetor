# Praetor configuration (spec 11). One variable per line.
# `make` passes this file first and the repo's `.env` second, so `.env` overrides these defaults.
# Secrets are empty here: `pnpm keys` fills them into `.env` (mode 600). Never commit a filled copy.

# Environment: local | local-live | rehearsal | prod. Only prod triggers the prod refusals (I13).
PRAETOR_ENV=local
PUBLIC_HOST=praetor.localhost
PUBLIC_URL=https://praetor.localhost

# Base: fork (anvil) or live (Base Sepolia).
CHAIN_MODE=fork
BASE_RPC_URL=http://anvil:8545
BASE_LIVE_RPC_URL=https://sepolia.base.org
# Pinned fork block, same as infra/deployments/fork.json (Q7). Refresh only on purpose.
FORK_BLOCK=48226000
DEPLOYMENTS_FILE=infra/deployments/fork.json
# EIP-712 domain name: Praetor-local (fork) | Praetor (live) | Praetor-sandbox.
DOMAIN_NAME=Praetor-local
# Live runs divide every demo amount by this (Q30).
DEMO_SCALE=1

# FISCO BCOS.
FISCO_SM=0
FISCO_RPC_URL=http://fisco-node0:8545
FISCO_GROUP=group0
# Consortium contract addresses (written by make deploy-fisco).
FISCO_DEPLOYMENTS_FILE=infra/deployments/fisco-local.json

# Bridge transport: relayer | wecross.
BRIDGE=relayer
BRIDGE_WATCHDOG_S=120

# TEEs: simulator | phala. Prod refuses simulator (I13, Q33).
ATTESTATION_MODE=simulator
DSTACK_SIMULATOR_ENDPOINT=
AGENT_SIGNER_URL=http://agent-signer:3050
SOTER_ATTESTER_URL=http://soter-attester:3060
SOTER_COUNTER_STRICT=1
ALLOWED_COMPOSE_HASHES_AGENT=
ALLOWED_COMPOSE_HASHES_ATTESTER=
# Local stack only, until the agent-signer TEE quote is verified (M7): KYA without a quote. Prod refuses 1.
KYA_ALLOW_UNATTESTED=1

# WeChat (human values, Phase A). Empty: SOTER fixture and log sink (BLOCKERS B2).
MP_APPID=
MP_SECRET=
OA_APPID=
OA_SECRET=
OA_TOKEN=
OA_TEMPLATE_ID=
# Tests point this at the fake Tencent; prod refuses anything else.
WECHAT_API_BASE=https://api.weixin.qq.com
# Tests only; prod refuses 1.
SOTER_FAKE_TENCENT=0

# Web push.
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:team@praetor.localhost

# Prices. Without PYTH_API_KEY the feeder runs in seeded DEMO mode (Q27).
PYTH_API_KEY=
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
DEMO_HOLD_S=600

# Agent (OpenCode).
AGENT_MODEL=opencode/deepseek-v4.1-flash-free
OPENCODE_API_KEY=
OPENCODE_SERVER_PASSWORD=
AGENT_MAX_ACTIVE=8

# Timers (prod: 900 / 300 / 900).
PRICE_CHECK_INTERVAL_S=30
HEARTBEAT_INTERVAL_S=60
HEARTBEAT_TTL_S=180

SANDBOX_ENABLED=1

# MySQL: root plus one password per service database.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD_API=
MYSQL_PASSWORD_MCP=
MYSQL_PASSWORD_BANK=
MYSQL_PASSWORD_REGULATOR=
MYSQL_PASSWORD_OPERATOR=
MYSQL_PASSWORD_PAYOUT=
MYSQL_PASSWORD_WEID=
MYSQL_PASSWORD_WEBASE=
MYSQL_PASSWORD_WECROSS=
MYSQL_PASSWORD_BUNDLER=

# Shared secrets (generated).
SESSION_SECRET=
KYC_ENC_KEY=
KYC_VENDOR_HMAC=
# EUDI wallet KYC path (Q45): the EU reference verifier backend issues client_id and request_uri.
EUDI_VERIFIER_BACKEND=https://verifier-backend.eudiw.dev
EUDI_INTENDED_USE_ID=TEST-01
MCP_OAUTH_SIGNING_KEY=
SIGNER_HMAC_MCP=
SIGNER_HMAC_API=
SIGNER_HMAC_BANK=
ATTESTER_HMAC_API=
INTERNAL_TOKEN_BUNDLER=
INTERNAL_TOKEN_MEMBERS=
STAFF_ENROL_TOKEN_BANK=
STAFF_ENROL_TOKEN_REGULATOR=
STAFF_ENROL_TOKEN_OPERATOR=
EUDI_VERIFIER_KEY=
EUDI_VERIFIER_CERT=
ALIPAYPLUS_TEST_MERCHANT_PRIVATE_KEY=
ALIPAYPLUS_TEST_MERCHANT_PUBLIC_KEY=
ALIPAYPLUS_TEST_GATEWAY_PRIVATE_KEY=
ALIPAYPLUS_TEST_GATEWAY_PUBLIC_KEY=
# Deploy only (Phase C).
PHALA_CLOUD_API_KEY=

# Wallet keys (secp256k1). `.env` holds three sets, LOCAL_*, LIVE_*, SANDBOX_* (D1); services read the
# unprefixed name first (prod server), then the prefix of the active set (fork: LOCAL, live: LIVE).
DEPLOYER_KEY=
BUNDLER_KEY=
PAYMASTER_SIGNER_KEY=
ORACLE_FEEDER_KEY=
DESK_OPERATOR_KEY=
PAYOUT_PARTNER_KEY=
WECROSS_BASE_KEY=
TREASURY_KEY=
RECOVERY_GUARDIAN_KEY=
BANK_FISCO_KEY=
BANK_BASE_SIGNER_KEY=
REGULATOR_FISCO_KEY=
REGULATOR_BASE_SIGNER_KEY=
OPERATOR_FISCO_KEY=
OPERATOR_BASE_SIGNER_KEY=
WEID_ADMIN_KEY=
WECROSS_FISCO_KEY=
RELAYER_FISCO_KEY=
