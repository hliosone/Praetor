# Live mode (M16, D74): `make up LIVE=1` reads this file after infra/.env.example and .env. The stack then runs on
# Base Sepolia with the LIVE_ key set and the live deployments, at production intervals. No secrets in this file.
CHAIN_MODE=live
BASE_RPC_URL=https://sepolia.base.org
DEPLOYMENTS_FILE=infra/deployments/base-sepolia.json
FISCO_DEPLOYMENTS_FILE=infra/deployments/fisco-live.json
DOMAIN_NAME=Praetor
DEMO_SCALE=100
# Every heartbeat and anchor is a Base transaction: production intervals (spec 11) keep the run in budget.
PRICE_CHECK_INTERVAL_S=900
HEARTBEAT_INTERVAL_S=300
HEARTBEAT_TTL_S=900
ANCHOR_INTERVAL_S=3600
AUDIT_FROM=deploy
# One Hermes request every 5 minutes (D89: Pyth only on live).
FEED_INTERVAL_S=300
