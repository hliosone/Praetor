{
  "$schema": "https://opencode.ai/config.json",
  "model": "fake/scripted",
  "small_model": "fake/scripted",
  "permission": {
    "*": "ask",
    "praetor_*": "allow"
  },
  "provider": {
    "fake": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Scripted fake LLM",
      "options": {
        "baseURL": "http://127.0.0.1:19012/v1",
        "apiKey": "not-a-secret"
      },
      "models": {
        "scripted": {
          "name": "scripted",
          "tool_call": true
        }
      }
    }
  },
  "mcp": {
    "praetor": {
      "type": "remote",
      "url": "http://127.0.0.1:19011/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer FAKE-TOKEN-V6-0123456789"
      }
    }
  }
}