# JDK 11 toolbox for WeIdentity Build-Tools and the REST service (spec 10 Phase A asks for JDK 11).
FROM eclipse-temurin:11-jdk@sha256:e25e6f22a886aff4da695ac1a239c0f608ff997622a8c39d754066fffcd58ee3
RUN apt-get update && apt-get install -y --no-install-recommends gettext-base git curl procps && rm -rf /var/lib/apt/lists/*
